#: kernel_installer_gui/app/application.py:324
#: kernel_installer_gui/app/main_window.py:51
msgid "Kernel Installer"
msgstr "Установщик ядра"

#: kernel_installer_gui/app/application.py:327
msgid ""
"A graphical interface for downloading, compiling and installing the Linux "
"kernel with optimized profiles."
msgstr ""
"Графический интерфейс для загрузки, компиляции и установки ядра Linux с "
"оптимизированными профилями."

#: kernel_installer_gui/app/application.py:349
msgid "Clean build files?"
msgstr "Очистить файлы сборки?"

#: kernel_installer_gui/app/application.py:352
msgid ""
"All temporary files in ~/kernel_build will be deleted.\n"
"This will free up disk space."
msgstr ""
"Все временные файлы в ~/kernel_build будут удалены.\n"
"Это освободит место на диске."

#: kernel_installer_gui/app/application.py:361
msgid "Build files deleted."
msgstr "Файлы сборки удалены."

#: kernel_installer_gui/app/application.py:363
msgid "Error cleaning files."
