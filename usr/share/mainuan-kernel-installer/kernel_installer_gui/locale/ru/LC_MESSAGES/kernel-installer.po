msgid "Cancellation requested by user..."
msgstr "Отмена запрошена пользователем..."

#: kernel_installer_gui/app/main_window.py:454
msgid "Starting removal..."
msgstr "Начало удаления..."

#: kernel_installer_gui/app/main_window.py:479
msgid "Remove kernel?"
msgstr "Удалить ядро?"

#: kernel_installer_gui/app/main_window.py:482
#, python-format
msgid ""
"Are you sure you want to completely remove Linux %(version)s?\n"
"\n"
"This will delete the kernel image, modules, and update the bootloader."
msgstr ""
"Вы уверены, что хотите полностью удалить Linux %(version)s?\n"
"\n"
"Это удалит образ ядра, модули и обновит загрузчик."

#: kernel_installer_gui/app/main_window.py:501
msgid "Kernel removed successfully"
msgstr "Ядро успешно удалено"

#: kernel_installer_gui/app/main_window.py:515
#: kernel_installer_gui/core/kernel.py:509
msgid "Installation complete!"
msgstr "Установка завершена!"

#: kernel_installer_gui/app/main_window.py:518
msgid ""
"The kernel has been installed successfully.\n"
"\n"
"Do you want to reboot now to use the new kernel?"
